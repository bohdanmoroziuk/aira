{
  "files.watcherExclude": {
    "**/.nuxt/**": true,
    "**/.output/**": true,
    "**/.nitro/**": true,
    "**/.data/**": true,
    "**/.cache/**": true,
    "**/dist/**": true,
    "**/coverage/**": true
  },
  "search.exclude": {
    "**/coverage": true,
    "**/pnpm-lock.yaml": true
  },
  "files.exclude": {
    "**/.DS_Store": true
  },
  "search.followSymlinks": false,
  "npm.packageManager": "pnpm",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.maxMemory": 4096
}
